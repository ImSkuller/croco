# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
data
./data
dist
dist-ssr
*.local

# Rust build output — already excluded by Cargo's own target/.gitignore in
# practice, but listed explicitly so it's not relying on that alone.
/src-tauri/target

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.env

/src/test
/release
.claude

# AI working notes - never commit
CLAUDE.md
improvements.md
# /docs/* (not /docs) so a "not ignored" exception below can still be
# reached - git won't traverse into a fully-excluded directory to apply
# per-file negation patterns underneath it.
/docs/*
# Exception: real, reviewable deliverables explicitly asked for by name,
# not scratch notes. Ask before adding another one.
!docs/ui-audit.md
